{
  "name": "@dnsdoctor/openclaw-plugin",
  "version": "1.5.0",
  "description": "OpenClaw plugin for DNS Doctor — diagnoses SPF, DMARC, DKIM, MX, DNS, blacklist and expiry over the public DNS Doctor REST API.",
  "license": "Apache-2.0",
  "author": {
    "name": "DNS Doctor",
    "url": "https://dnsdoctor.dev"
  },
  "homepage": "https://dnsdoctor.dev/methodology",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnsdoctor/openclaw-plugin.git"
  },
  "keywords": [
    "openclaw",
    "dns",
    "email",
    "spf",
    "dmarc",
    "dkim",
    "deliverability"
  ],
  "type": "module",
  "private": true,
  "files": [
    "dist",
    "tools.json",
    "openclaw.plugin.json"
  ],
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.8.1",
      "pluginSdkVersion": "2026.8.1"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.24-beta.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "openclaw": "2026.8.1",
    "typebox": "1.3.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
